# Atheris — Environment Variables
# Copy to .env and adjust for your environment. All values below are dev defaults.
# Never commit real secrets. In production, CHANGE every placeholder marked CHANGE IN PROD.

# ── Database (shared by intel + tenant) ──
DB_HOST=localhost
DB_PORT=5432
DB_NAME=atheris_intel
# Tenant DB name (tenant backend uses ${DB_NAME:atheris_tenant} -> override if needed)
# DB_NAME=atheris_tenant
# DB username/password are read from the environment — no default. Must match an OS/launchctl env var.
DB_USERNAME=atheris
DB_PASSWORD=  # CHANGE IN PROD — required, no default in application.yml

# ── Server Ports ──
PORT=9090                    # Intel backend (atheris-compliance-intelligence-backend)
# Tenant backend uses same PORT var with default 9091 when not set:
# PORT=9091                  # uncomment to override tenant port explicitly
TENANT_PORT=9091             # alternative explicit tenant port (vite proxy uses VITE_TENANT_TARGET)
VITE_INTEL_TARGET=http://localhost:9090
VITE_TENANT_TARGET=http://localhost:9091

# ── Vite Frontend (optional) ──
# VITE_API_BASE_URL=/api/v1

# ── Auth / Admin ──
ADMIN_USERNAME=admin@gmail.com
ADMIN_PASSWORD=changeme       # CHANGE IN PROD — required, no default in prod profile
JWT_SECRET=atheris-platform-jwt-secret-change-in-production-min-32-chars  # CHANGE IN PROD — min 32 chars
# Tenant JWT (same env var name, tenant default is different fallback):
# JWT_SECRET=change-me-in-production-use-a-long-random-base64-secret
DEMO_JWT_TOKEN=demo-jwt-token  # dev-only bypass token (atheris.demo-jwt-token)

# ── Dev tenant users (tenant backend DevUserSeeder) ──
# dev only — never enable in production
# Seeds admin@/cco@/analyst@/auditor@<SEED_USERS_DOMAIN> on start (idempotent).
# Password must pass the invite/reset rule: 8+ chars, uppercase, number, special char.
SEED_USERS_ENABLED=false
SEED_USERS_DOMAIN=mamcorp.test
SEED_USERS_PASSWORD=

# ── Encryption ──
ENCRYPTION_KEY=temporary-dev-encryption-key-change-in-prod  # CHANGE IN PROD

# ── AI Provider (OpenRouter, OpenAI-compatible) ──
OPENROUTER_API_KEY=           # required — no default. Never commit a real key.
AI_MODEL=google/gemini-2.5-flash-lite   # any OpenRouter model id; ":free" ids need no credits
# AI_FALLBACK_MODEL=            # optional — unset uses application.yml default (google/gemini-2.5-flash-lite); an empty value would blank it
AI_BASE_URL=https://openrouter.ai/api   # base-url omits /v1 (Spring AI appends /v1/chat/completions)
# NOTE: the backends read .env as a .properties file, where "#" only starts a comment at
# the START of a line — keep comments on their own line for the variables below.
# OpenRouter reasoning switch for primary + fallback: unset/empty = send nothing (provider
# default); false = send "reasoning": {"enabled": false} (needed for reasoning models such
# as nvidia/nemotron-3-super-120b-a12b:free, which otherwise burn max tokens thinking).
# AI_REASONING_ENABLED=false
# Max output tokens per AI call (default 3500).
# AI_MAX_TOKENS=3500
# NOTE: toolkit obligation points are baked into compliance_toolkits.json offline
# (tools/toolkit-md-points/generate_points.py); there is no runtime points job and
# therefore no POINTS_* variables.

# ── Platform / Tenant Link ──
PLATFORM_BASE_URL=http://localhost:9090  # tenant -> intel; ${PLATFORM_BASE_URL}

# ── Storage ──
STORAGE_PROVIDER=local        # local | s3
S3_BUCKET=atheris-platform-docs
AWS_REGION=af-south-1
STORAGE_LOCAL_PATH=../../../data/storage

# ── Email ──
EMAIL_FROM=noreply@atheris.com
BASE_URL=https://app.atheris.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ── Tenant Onboarding / Polling ──
# atheris.returns.instance-lookahead-days=120
# atheris.returns.escalation-thresholds=2,5

# ── Tenant Polling (frontend uses polling interval from DB) ──
# No env needed — configured via PUT /api/v1/settings/polling
