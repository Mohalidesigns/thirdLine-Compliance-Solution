# Seed directory for the Atheris LDAP test bed (osixia/openldap 1.5.0).
#
# Loaded via LDAP_SEED_INTERNAL_LDIF_PATH on first start. The base entry
# dc=atheris,dc=test is created by the image from LDAP_DOMAIN, so it is NOT repeated here.
# The service account is cn=admin,dc=atheris,dc=test / adminpassword.
#
# The tenant app's onboarding should use:
#   URL               ldap://localhost:1389
#   Bind DN           cn=admin,dc=atheris,dc=test
#   Bind password     adminpassword
#   User search base  ou=people,dc=atheris,dc=test
#   Search attribute  mail
#   Full-name attr    cn
#
# Layout: every department from tools/toolkit-ownership/org_vocab.json gets a head and one
# officer per unit, all under the flat ou=people (so the onboarding search base is unchanged).
# All directory passwords are "Passw0rd!".
#
# Department heads (the org-chart "escalation L2/manager" targets):
#   headofcompliance@<domain>    Compliance
#   headofrisk@<domain>          Risk Management
#   headofit@<domain>            Information Technology
#   headofoperations@<domain>    Operations
#   headoffinance@<domain>       Finance & Treasury
#   chiefauditexecutive@<domain> Internal Audit
#   headoflegal@<domain>         Legal & Company Secretariat
#   headofhr@<domain>            Human Resources
#
# Functional accounts retained for onboarding/SoD/escalation flows:
#   cco@               chief compliance officer (escalation L3 + board-pack sign-off)
#   analyst@           control tester / remediation reviewer
#
# Directory-only: none of these are tenant app accounts (no users row, no role). They exist so
# the onboarding CCO/Analyst picker, owner search and SoD tests have real people to choose.

dn: ou=people,dc=atheris,dc=test
objectClass: organizationalUnit
ou: people

